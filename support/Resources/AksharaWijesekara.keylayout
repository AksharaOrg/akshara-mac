<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE keyboard SYSTEM "file://localhost/System/Library/DTDs/KeyboardLayout.dtd">
<!-- Private keyboard layout used only as Akshara's SLS1134 IME override. -->
<keyboard group="126" id="-30001" name="Akshara Wijesekara" maxout="1">
  <layouts>
    <layout first="0" last="17" mapSet="ANSI" modifiers="commonModifiers"/>
  </layouts>
  <modifierMap id="commonModifiers" defaultIndex="0">
    <keyMapSelect mapIndex="0"><modifier keys=""/></keyMapSelect>
    <keyMapSelect mapIndex="1"><modifier keys="anyShift"/></keyMapSelect>
    <keyMapSelect mapIndex="2"><modifier keys="anyOption"/></keyMapSelect>
    <keyMapSelect mapIndex="3"><modifier keys="shift? option? command? control? caps?"/></keyMapSelect>
  </modifierMap>
  <keyMapSet id="ANSI">
    <!-- Normal: the direct Wijesekara/SLS1134 labels. -->
    <keyMap index="0">
      <key code="0" output="්"/><key code="1" output="ි"/><key code="2" output="ා"/><key code="3" output="ෙ"/>
      <key code="4" output="ය"/><key code="5" output="ට"/><key code="6" output="'"/><key code="7" output="ං"/>
      <key code="8" output="ජ"/><key code="9" output="ඩ"/><key code="11" output="ඉ"/>
      <key code="12" output="ු"/><key code="13" output="අ"/><key code="14" output="ැ"/><key code="15" output="ර"/>
      <key code="16" output="හ"/><key code="17" output="එ"/><key code="18" output="1"/><key code="19" output="2"/>
      <key code="20" output="3"/><key code="21" output="4"/><key code="22" output="6"/><key code="23" output="5"/>
      <key code="24" output="="/><key code="25" output="9"/><key code="26" output="7"/><key code="27" output="-"/>
      <key code="28" output="8"/><key code="29" output="0"/><key code="30" output=";"/><key code="31" output="ද"/>
      <key code="32" output="ම"/><key code="33" output="ඤ"/><key code="34" output="ස"/><key code="35" output="ච"/>
      <key code="37" output="ක"/><key code="38" output="ව"/><key code="39" output="."/><key code="40" output="න"/>
      <key code="41" output="ත"/><key code="42" output="&#x200B;"/><key code="43" output="ල"/><key code="44" output="/"/>
      <key code="45" output="බ"/><key code="46" output="ප"/><key code="47" output="ග"/><key code="49" output=" "/>
      <key code="50" output="්‍ර"/>
    </keyMap>
    <!-- Shift labels.  Special shaping controls intentionally have no label. -->
    <keyMap index="1">
      <key code="0" output="ෟ"/><key code="1" output="ී"/><key code="2" output="ෘ"/><key code="3" output="ෆ"/>
      <key code="4" output="&#x200B;"/><key code="5" output="ඨ"/><key code="6" output="&quot;"/><key code="7" output="ඞ"/><key code="8" output="ඣ"/>
      <key code="9" output="ඪ"/><key code="11" output="ඊ"/><key code="12" output="ූ"/><key code="13" output="උ"/>
      <key code="14" output="ෑ"/><key code="15" output="ඍ"/><key code="16" output="ශ"/><key code="17" output="ඔ"/>
      <key code="18" output="!"/><key code="19" output="@"/><key code="20" output="#"/><key code="21" output="$"/>
      <key code="22" output="^"/><key code="23" output="%"/><key code="24" output="+"/><key code="25" output="("/>
      <key code="26" output="&amp;"/><key code="27" output="_"/><key code="28" output="*"/><key code="29" output=")"/>
      <key code="30" output=":"/><key code="31" output="ධ"/><key code="32" output="ඹ"/><key code="33" output="ඕ"/>
      <key code="34" output="ෂ"/><key code="35" output="ඡ"/><key code="37" output="ඛ"/><key code="38" output="ළු"/>
      <key code="40" output="ණ"/><key code="41" output="ථ"/><key code="42" output="&#x200B;"/><key code="43" output="ළ"/><key code="44" output="?"/>
      <key code="45" output="භ"/><key code="46" output="ඵ"/><key code="47" output="ඝ"/><key code="50" output="&#x200B;"/>
    </keyMap>
    <!-- Option/AltGr entries exposed by the SLS mode. -->
    <keyMap index="2">
      <key code="0" output="ෳ"/><key code="6" output="&#x200B;"/><key code="7" output="ඃ"/><key code="8" output="ඦ"/>
      <key code="9" output="ඬ"/><key code="15" output="ඳ"/><key code="39" output="෴"/><key code="42" output="&#x200B;"/><key code="43" output="ඏ"/>
      <key code="47" output="ඟ"/><key code="49" output="‌"/>
    </keyMap>
    <keyMap index="3"><key code="0" output=""/></keyMap>
  </keyMapSet>
</keyboard>
